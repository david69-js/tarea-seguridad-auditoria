# =====================================================================
#  Variables de entorno de ejemplo.
#  En LOCAL puedes copiarlas a un .env; en RAILWAY se configuran en el
#  panel del servicio (el plugin de MySQL crea las MYSQL* automáticamente).
# =====================================================================

# --- Base de datos (desarrollo local sin Docker) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pos_libreria
DB_USER=root
DB_PASSWORD=root

# --- En Railway el plugin de MySQL expone automáticamente: ---
# MYSQLHOST, MYSQLPORT, MYSQLDATABASE, MYSQLUSER, MYSQLPASSWORD
# (o la URL completa en MYSQL_URL). La app las detecta sola.

# --- Clima del dashboard (API externa OpenWeatherMap) ---
# Clave gratuita: https://home.openweathermap.org/api_keys
# Si no se define, el dashboard muestra "Clima no disponible" y todo lo
# demas sigue funcionando con normalidad.
OPENWEATHER_API_KEY=
OPENWEATHER_CIUDAD=Guatemala City,GT
